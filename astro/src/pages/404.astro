---
// Port of the default Next.js 404 page in nextjs-v3/out/404.html (no header/footer, noindex).
// Text lives in src/content/notfound.json. Output: dist/404.html.
import notfound from "../content/notfound.json";
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{notfound.title}</title>
    <link rel="icon" href="/favicon.ico" sizes="256x256" type="image/x-icon" />
    <style is:inline>
      body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}
    </style>
  </head>
  <body>
    <div style='font-family:system-ui,"Segoe UI",Roboto,Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji";height:100vh;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center'>
      <div>
        <h1 class="next-error-h1" style="display:inline-block;margin:0 20px 0 0;padding:0 23px 0 0;font-size:24px;font-weight:500;vertical-align:top;line-height:49px">{notfound.code}</h1>
        <div style="display:inline-block"><h2 style="font-size:14px;font-weight:400;line-height:49px;margin:0">{notfound.message}</h2></div>
      </div>
    </div>
  </body>
</html>
