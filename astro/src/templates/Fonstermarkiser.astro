---
// Template "fonstermarkiser" (/fonstermarkiser-malmo/). All text from src/content/pages/fonstermarkiser-malmo.md.
// Section order follows /markiser-malmo/: hero, AnswerBox, I korthet, models, comparison,
// cross-links, process, cost, guarantee, FAQ, CTA.
import BaseLayout from "../layouts/BaseLayout.astro";
import AnswerBox from "../components/AnswerBox.astro";
import Hero from "../components/markiser/Hero.astro";
import Band from "../components/markiser/Band.astro";
import ModelCard from "../components/markiser/ModelCard.astro";
import FaqSection from "../components/markiser/FaqSection.astro";
import FinalCta from "../components/markiser/FinalCta.astro";
import TldrPlain from "../components/sections/TldrPlain.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import ComparisonTable from "../components/sections/ComparisonTable.astro";
import CrossLinkCards from "../components/sections/CrossLinkCards.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CostFactors from "../components/sections/CostFactors.astro";
import GuaranteeTiles from "../components/sections/GuaranteeTiles.astro";
import { buildSchema } from "../lib/page-schema";

const { entry, path } = Astro.props;
const d = entry.data;
const schema = buildSchema(d.schema, { path, title: d.title, description: d.description, faqs: d.faq.items });
const W = "mx-auto max-w-5xl px-6 lg:px-10 py-20 md:py-24";
---
<BaseLayout
  twitterCard={d.twitterCard}
  robots={d.robots} title={d.title} description={d.description} path={path} ogTitle={d.ogTitle} ogDescription={d.ogDescription} ogImage={d.ogImage} breadcrumbs={d.schemaBreadcrumbs ?? d.breadcrumbs} schema={schema}>
  <main class="flex-1 bg-canvas">
    <Hero hero={d.hero} watermarkClass="text-[16vw] md:text-[12vw]" />

    <div class="mx-auto max-w-4xl px-6 lg:px-10 pt-16 md:pt-20">
      <AnswerBox html={d.answerBox} />
      <p class="mt-3 text-sm text-ink-soft">{d.updatedLabel}</p>
    </div>

    <TldrPlain tldr={d.tldr} />

    {d.modelGroups.map((group, g) => (
      <section id={group.id} class:list={[g % 2 === 0 && "bg-canvas-soft border-y border-ink/8"]}>
        <div class="mx-auto max-w-5xl px-6 lg:px-10 pt-20 md:pt-24 pb-8 md:pb-12">
          <div class="max-w-2xl">
            <SectionHeading heading={group.heading} intro={group.intro} />
            {group.note && <p class="mt-4 body-copy text-ink-soft">{group.note}</p>}
          </div>
          {group.models.map((model, i) => (
            <ModelCard model={model} index={g === 0 ? i : i + 1} isLast={i === group.models.length - 1} />
          ))}
        </div>
      </section>
    ))}

    <section id="jamforelse" class="bg-canvas-soft border-y border-ink/8">
      <div class="mx-auto max-w-6xl px-6 lg:px-10 py-20 md:py-24">
        <ComparisonTable section={d.comparison} />
      </div>
    </section>

    <Band container={W}><CrossLinkCards section={d.otherProducts} /></Band>
    <Band band container={W}><ProcessSteps section={d.process} /></Band>
    <Band container={W}><CostFactors section={d.investment} /></Band>
    <Band band container={W}><GuaranteeTiles section={d.warranty} /></Band>
    <FaqSection faq={d.faq} />
    <FinalCta cta={d.finalCta} />
  </main>
</BaseLayout>
