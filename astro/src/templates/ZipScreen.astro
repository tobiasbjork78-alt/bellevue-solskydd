---
// Template "zipScreen" (/zip-screen-malmo/). All text from src/content/pages/zip-screen-malmo.md.
// Section order follows /markiser-malmo/: hero, AnswerBox, I korthet, models, comparison,
// cross-links, process, cost, guarantee, FAQ, CTA.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import AnswerBox from "../components/AnswerBox.astro";
import HeroBreadcrumbs from "../components/utvandigt/HeroBreadcrumbs.astro";
import HeroContent from "../components/utvandigt/HeroContent.astro";
import DarkCTA from "../components/utvandigt/DarkCTA.astro";
import FAQList from "../components/FAQList.astro";
import ZipModelCard from "../components/utvandigt/ZipModelCard.astro";
import TldrPlain from "../components/sections/TldrPlain.astro";
import SectionHeading from "../components/sections/SectionHeading.astro";
import ComparisonTable from "../components/sections/ComparisonTable.astro";
import CrossLinkCards from "../components/sections/CrossLinkCards.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CostFactors from "../components/sections/CostFactors.astro";
import GuaranteeTiles from "../components/sections/GuaranteeTiles.astro";
import { buildSchema } from "../lib/page-schema";

const { entry, path } = Astro.props;
const d = entry.data;
const schema = buildSchema(d.schema, { path, title: d.title, description: d.description, faqs: d.faqs });
const fill = "absolute inset-0 h-full w-full";
const firstGroupId = d.modelGroups[0].id ?? "modeller";
---
<BaseLayout
  twitterCard={d.twitterCard}
  robots={d.robots}
  title={d.title}
  description={d.description}
  path={path}
  ogTitle={d.ogTitle}
  ogDescription={d.ogDescription}
  ogImage={d.ogImage}
  breadcrumbs={d.schemaBreadcrumbs ?? d.breadcrumbs}
  schema={schema}
>
  <main class="flex-1 bg-canvas">
    <section class="relative w-full h-[70vh] md:h-[78vh] md:min-h-[680px] overflow-hidden bg-ink">
      <img src={d.hero.image} alt={d.hero.alt} fetchpriority="high" decoding="async" sizes="100vw" class:list={[fill, "object-cover object-center opacity-55"]} />
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/35 to-black/20 md:bg-gradient-to-r md:from-black/50 md:via-black/30 md:to-black/20"></div>
      <div class="absolute inset-0 flex flex-col">
        <div class="mx-auto w-full max-w-6xl px-6 lg:px-10 pt-8 md:pt-10">
          {d.breadcrumbs && <HeroBreadcrumbs items={d.breadcrumbs} />}
        </div>
        <div class="flex-1"></div>
        <HeroContent hero={d.hero} secondaryHref={`#${firstGroupId}`} />
      </div>
    </section>

    <div class="mx-auto max-w-4xl px-6 lg:px-10 pt-16 md:pt-20">
      <AnswerBox html={d.answerBox} />
      <p class="mt-3 text-sm text-ink-soft">{d.updatedLabel}</p>
    </div>

    <TldrPlain tldr={d.tldr} />

    <section class="w-full">
      <img src={d.contextImage.src} width={d.contextImage.width} height={d.contextImage.height} alt={d.contextImage.alt} loading="lazy" decoding="async" class="w-full h-auto" />
    </section>

    {d.modelGroups.map((group, g) => (
      <section id={group.id} class:list={[g % 2 === 0 ? "bg-canvas-soft border-y border-ink/8" : "bg-canvas"]}>
        <div class="mx-auto max-w-6xl px-6 lg:px-10 pt-20 md:pt-24 pb-8 md:pb-12">
          <div class="max-w-2xl">
            <SectionHeading heading={group.heading} intro={group.intro} />
            {group.note && <p class="mt-4 body-copy text-ink-soft">{group.note}</p>}
          </div>
          <div class="mt-6">
            {group.models.map((model, i) => (
              <ZipModelCard model={{ ...model, image: model.image ?? undefined }} index={g === 0 ? i : i + 1} isLast={i === group.models.length - 1} />
            ))}
          </div>
        </div>
      </section>
    ))}

    <section id="jamforelse" class="mx-auto max-w-6xl px-6 lg:px-10 py-20 md:py-24">
      <ComparisonTable section={d.comparison} />
    </section>

    <section class="bg-canvas-soft border-y border-ink/8">
      <div class="mx-auto max-w-5xl px-6 lg:px-10 py-20 md:py-24">
        <CrossLinkCards section={d.otherProducts} />
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 lg:px-10 py-20 md:py-24">
      <ProcessSteps section={d.process} />
    </section>

    <section class="bg-canvas-soft border-y border-ink/8">
      <div class="mx-auto max-w-5xl px-6 lg:px-10 py-20 md:py-24">
        <CostFactors section={d.investment} />
      </div>
    </section>

    <section class="relative overflow-hidden mx-auto max-w-4xl px-6 lg:px-10 py-20 md:py-24">
      <img src={d.warranty.backgroundImage} alt="" aria-hidden="true" loading="lazy" decoding="async" sizes="100vw" class:list={[fill, "object-cover object-left"]} />
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-canvas-soft/30 via-canvas-soft/60 to-canvas-soft/85"></div>
      <div class="relative z-10 md:ml-auto md:max-w-[55%]">
        <GuaranteeTiles section={d.warranty} stacked />
      </div>
    </section>

    <section class="bg-canvas-soft border-y border-ink/8">
      <div class="mx-auto max-w-5xl px-6 lg:px-10 py-20 md:py-24">
        <h2 class="heading-section text-3xl md:text-4xl text-ink leading-tight">{d.faqHeading}</h2>
        <Divider class="mt-7 mb-2" />
        <div class="mt-4">
          <FAQList faqs={d.faqs} firstAnswerClass="speakable-faq-1" />
        </div>
      </div>
    </section>

    <DarkCTA cta={d.cta} />
  </main>
</BaseLayout>
