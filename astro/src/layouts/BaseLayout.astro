---
// Shared document shell: head meta (canonical/og without www), JSON-LD graph
// (BreadcrumbList added here exactly once), Header, Footer, StickyMobileCTA.
// Self-hosted via Fontsource, same weights and subset (latin) as next/font in nextjs-v3
import "@fontsource/fraunces/latin-400.css";
import "@fontsource/fraunces/latin-500.css";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import { abs, breadcrumbSchema, graph } from "../lib/schema";
// Generated by scripts/og-images.mjs: og:image per page path, with a shared standard image
import ogImages from "../data/og-images.json";

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Overrides the generated og:image (site-relative path to a 1200×630 image) */
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: "summary" | "summary_large_image";
  robots?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  schema?: Record<string, unknown>[];
}

const { title, description, path, ogTitle, ogDescription, ogImage, ogImageAlt, twitterCard = "summary_large_image", robots, breadcrumbs, schema = [] } = Astro.props;
const canonical = abs(path);
const og = (ogImages.pages as Record<string, { image: string; alt: string; width: number; height: number }>)[path] ?? ogImages.standard;
const ogImageUrl = abs(ogImage ?? og.image);
const ogAlt = ogImage ? ogImageAlt ?? "" : og.alt;
const nodes = [
  ...(breadcrumbs && breadcrumbs.length ? [breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: abs(b.url) })))] : []),
  ...schema,
];
const jsonLd = nodes.length ? JSON.stringify(graph(...nodes)).replace(/</g, "\\u003c") : null;
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bellevue Solskydd" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href="/favicon.ico" sizes="256x256" type="image/x-icon" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <slot />
    <Footer />
    <StickyMobileCTA />
  </body>
</html>
