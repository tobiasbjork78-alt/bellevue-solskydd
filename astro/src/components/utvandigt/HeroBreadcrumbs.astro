---
// Inverse breadcrumbs used inside the dark hero of the utvändiga pages.
interface Props { items: Array<{ name: string; url: string }> }
const { items } = Astro.props;
---
<nav aria-label="Brödsmulor" class="text-sm body-copy text-ink-inverse/75">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) =>
      index === items.length - 1 ? (
        <li>
          <span class="text-ink-inverse" aria-current="page">{item.name}</span>
        </li>
      ) : (
        <li class="flex items-center gap-2">
          <a href={item.url} class="hover:text-ink-inverse transition-colors">{item.name}</a>
          <span aria-hidden="true" class="text-ink-inverse/40">›</span>
        </li>
      )
    )}
  </ol>
</nav>
