---
// Model card for /zip-screen-malmo/: image (4:3, object-contain) left, maker above model name, facts right.
interface Props {
  model: {
    maker: string;
    name: string;
    type: string;
    body: string;
    specs: string[];
    passarDigOm?: string;
    extraNote?: { kind: "kundord" | "begransning"; text: string; source?: string };
    alt: string;
    image?: string;
  };
  index: number;
  isLast: boolean;
}
const { model, index, isLast } = Astro.props;
const PLACEHOLDER =
  "data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%221%22%20height%3D%221%22%2F%3E";
const fill = "absolute inset-0 h-full w-full";
const note = model.extraNote;
---
<article class:list={["grid gap-8 md:gap-12 md:grid-cols-2 md:items-center", "py-12 md:py-16", !isLast && "border-b border-brand-brass/30"]}>
  <div class="relative aspect-[4/3] max-h-[500px] bg-transparent overflow-hidden">
    {model.image ? (
      <img src={model.image} alt={model.alt} decoding="async" sizes="(max-width: 768px) 100vw, 50vw" {...(index === 0 ? { fetchpriority: "high" } : { loading: "lazy" })} class:list={[fill, "object-contain"]} />
    ) : (
      <>
        <img src={PLACEHOLDER} alt={model.alt} decoding="async" class:list={[fill, "object-cover opacity-0"]} />
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-ink/25 font-display text-3xl md:text-4xl tracking-wide select-none">{model.name}</span>
        </div>
      </>
    )}
  </div>

  <div class="md:py-2">
    <p class="text-xs font-medium uppercase tracking-[0.22em] text-brand-green mb-3">{model.maker}</p>
    <h3 class="font-display text-ink tracking-tight leading-[1.05] mb-2 text-3xl md:text-4xl lg:text-5xl">{model.name}</h3>
    <p class="text-sm font-medium text-ink-soft mb-6">{model.type}</p>
    <p class="body-copy text-ink mb-6 max-w-prose">{model.body}</p>
    {model.specs.length > 0 && (
      <ul class="space-y-2 text-sm body-copy text-ink-soft list-none mb-6">
        {model.specs.map((spec) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="text-brand-brass select-none leading-snug">—</span>
            <span>{spec}</span>
          </li>
        ))}
      </ul>
    )}
    {model.passarDigOm && <p class="text-sm body-copy text-ink-soft border-l-2 border-brand-brass/40 pl-4 italic">{model.passarDigOm}</p>}
    {note && (
      <div class="mt-6 pt-5 border-t border-ink/8">
        <p class="text-sm body-copy text-ink-soft">
          {note.kind === "kundord" ? (
            <>
              <span class="text-ink">“{note.text}”</span>
              {note.source && <> <span class="text-ink-soft/70 text-xs">— {note.source}</span></>}
            </>
          ) : (
            <>
              {note.text}
              {note.source && <> <span class="text-ink-soft/70 text-xs">({note.source})</span></>}
            </>
          )}
        </p>
      </div>
    )}
  </div>
</article>
