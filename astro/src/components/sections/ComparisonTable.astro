---
// Comparison section: real <table> from 768 px, stacked cards with <dl> on mobile.
// First column = row header (model name).
import SectionHeading from "./SectionHeading.astro";
import type { ComparisonData } from "../../content/schemas/sections";
interface Props { section: ComparisonData }
const { section } = Astro.props;
---
<div class="max-w-2xl">
  <SectionHeading heading={section.heading} intro={section.intro} />
</div>

<table class="mt-12 hidden md:table w-full text-left body-copy text-sm">
  <thead>
    <tr class="border-b border-ink/15">
      {section.columns.map((col) => (
        <th scope="col" class="py-4 pr-6 font-medium text-ink">{col}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {section.rows.map((row) => (
      <tr class="border-b border-ink/10 align-top">
        {row.map((cell, i) =>
          i === 0 ? (
            <th scope="row" class="py-4 pr-6 font-display text-lg font-normal text-ink">{cell}</th>
          ) : (
            <td class="py-4 pr-6 text-ink-soft">{cell}</td>
          )
        )}
      </tr>
    ))}
  </tbody>
</table>

<div class="mt-10 space-y-4 md:hidden">
  {section.rows.map((row) => (
    <div class="rounded-premium border border-ink/10 bg-canvas px-6 py-5">
      <p class="font-display text-xl text-ink">{row[0]}</p>
      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm body-copy">
        {row.slice(1).map((cell, i) => (
          <Fragment>
            <dt class="text-ink-soft">{section.columns[i + 1]}</dt>
            <dd class="text-ink">{cell}</dd>
          </Fragment>
        ))}
      </dl>
    </div>
  ))}
</div>

{section.footnote && <p class="mt-6 text-sm text-ink-soft">{section.footnote}</p>}
