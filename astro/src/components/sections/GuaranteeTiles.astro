---
// Guarantee section: 1–3 tiles, the figure is text (Fraunces, green), plus one service line.
// A single tile sits next to the service line from 768 px instead of alone in a grid.
import SectionHeading from "./SectionHeading.astro";
import type { GuaranteeTilesData } from "../../content/schemas/sections";
interface Props {
  section: GuaranteeTilesData;
  divider?: boolean;
  /** true = tiles always stacked (narrow column) */
  stacked?: boolean;
}
const { section, divider, stacked = false } = Astro.props;
const single = section.tiles.length === 1 && !stacked;
const cols = stacked || single ? "" : section.tiles.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2";
---
<SectionHeading heading={section.heading} intro={section.intro} divider={divider} />
<div class:list={["mt-10", single && "md:flex md:items-center md:gap-10"]}>
  <dl class:list={["grid gap-4", cols, single && "md:w-72 md:shrink-0"]}>
    {section.tiles.map((tile) => (
      <div class="flex flex-col-reverse justify-end rounded-soft border border-brand-linen bg-white px-6 py-6">
        <dt class="mt-3 body-copy text-ink-soft">{tile.label}</dt>
        <dd class="font-display text-5xl text-brand-green leading-none tracking-tight">{tile.value}</dd>
      </div>
    ))}
  </dl>
  <p class:list={["body-copy text-ink", single ? "mt-6 md:mt-0 md:max-w-md" : "mt-6"]}>{section.service}</p>
</div>
