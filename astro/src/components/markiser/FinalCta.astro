---
// Dark closing CTA.
import Icon from "../Icon.astro";
import Eyebrow from "../Eyebrow.astro";
import Divider from "../Divider.astro";
interface Props {
  cta: { eyebrow: string; headingLine1: string; headingLine2: string; body: string; cta: { label: string; href: string } };
}
const { cta } = Astro.props;
---
<section class="bg-ink text-ink-inverse">
  <div class="mx-auto max-w-5xl px-6 lg:px-10 py-24 md:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <Eyebrow tone="inverse" class="text-brand-brass">{cta.eyebrow}</Eyebrow>
        <h2 class="heading-section text-4xl md:text-5xl lg:text-6xl mt-5 text-ink-inverse leading-[1.1]">
          {cta.headingLine1}
          <br />
          {cta.headingLine2}
        </h2>
        <Divider tone="inverse" class="bg-brand-brass mt-8" />
      </div>
      <div class="md:col-span-5 md:pl-6">
        <p class="body-copy text-ink-inverse/80 mb-9 text-lg">{cta.body}</p>
        <a href={cta.cta.href} class="inline-flex items-center gap-2 rounded-full bg-canvas-soft px-7 py-4 text-ink font-medium transition-colors duration-300 ease-premium hover:bg-white">
          {cta.cta.label}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>
