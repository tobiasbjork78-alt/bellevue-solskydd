---
// Section wrapper. band=true: full-width soft band with inner container; false: container on <section>.
interface Props { band?: boolean; container: string; id?: string }
const { band = false, container, id } = Astro.props;
---
{band ? (
  <section id={id} class="bg-canvas-soft border-y border-ink/8">
    <div class={container}><slot /></div>
  </section>
) : (
  <section id={id} class={container}><slot /></section>
)}
