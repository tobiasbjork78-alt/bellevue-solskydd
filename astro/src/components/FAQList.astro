---
// Accordion. The first item is open on load (max-height none, answer visible);
// all answers are in the HTML, JS only toggles max-height.
import Icon from "./Icon.astro";
interface Props {
  faqs: Array<{ question: string; answer: string; link?: { label: string; href: string } }>;
  answerClass?: string;
  /** Class applied only to the first answer (e.g. speakable-faq-1) */
  firstAnswerClass?: string;
}
const { faqs, answerClass, firstAnswerClass } = Astro.props;
// 6 or more questions: two independent columns from 1024 px (first half left, second half right).
// Mobile keeps the original order because the columns stack.
const twoCols = faqs.length >= 6;
const half = Math.ceil(faqs.length / 2);
const columns = twoCols ? [faqs.slice(0, half), faqs.slice(half)] : [faqs];
const iconBase = "flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/15 text-ink transition-transform duration-500 ease-premium";
const iconOpen = "rotate-45 bg-brand-green text-ink-inverse border-brand-green";
---
<div data-faq-list class:list={[twoCols && "lg:grid lg:grid-cols-2 lg:gap-x-12"]}>
  {columns.map((column, c) => (
    <div>
      {column.map((faq, i) => {
        const index = c * half + i;
        const open = index === 0;
        return (
          <div class="border-b border-ink/10" data-faq-item>
            <h3 class="m-0 font-normal">
              <button type="button" aria-expanded={open ? "true" : "false"} class="flex w-full items-center justify-between gap-6 py-6 text-left" data-faq-toggle>
                <span class:list={["heading-section text-xl md:text-2xl text-ink", twoCols && "lg:text-xl"]}>{faq.question}</span>
                <span aria-hidden="true" class:list={[iconBase, open && iconOpen]} data-faq-icon data-open-class={iconOpen}>
                  <Icon name="plus" size={16} />
                </span>
              </button>
            </h3>
            <div style={open ? "max-height:none" : "max-height:0px"} class="overflow-hidden transition-[max-height] duration-500 ease-premium" data-faq-panel>
              <p class:list={["pr-12 body-copy text-ink-soft", faq.link ? "pb-3" : "pb-6", answerClass, index === 0 && firstAnswerClass]}>{faq.answer}</p>
              {faq.link && (
                <p class="pb-6 pr-12 text-sm">
                  <a href={faq.link.href} class="inline-flex items-center gap-2 font-medium text-brand-green hover:text-ink transition-colors">
                    {faq.link.label}
                    <Icon name="arrow-right" size={14} />
                  </a>
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-faq-toggle]").forEach((button) => {
    const item = button.closest("[data-faq-item]");
    const panel = item?.querySelector<HTMLElement>("[data-faq-panel]");
    const icon = item?.querySelector<HTMLElement>("[data-faq-icon]");
    if (!panel || !icon) return;
    const openClasses = (icon.dataset.openClass ?? "").split(" ").filter(Boolean);
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      const height = panel.firstElementChild?.scrollHeight ?? 0;
      if (!open && panel.style.maxHeight === "none") {
        // From "none" there is no animation start value: set px first, then close
        panel.style.maxHeight = `${height}px`;
        void panel.offsetHeight;
      }
      panel.style.maxHeight = open ? `${height}px` : "0px";
      openClasses.forEach((c) => icon.classList.toggle(c, open));
    });
  });
</script>
