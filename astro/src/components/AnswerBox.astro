---
// `html` is trusted content from src/content (may contain inline links/strong)
interface Props { html: string; label?: string; class?: string }
const { html, label = "Snabbsvar", class: className } = Astro.props;
---
<aside class:list={["rounded-premium border border-ink/10 bg-canvas-soft px-7 py-6 md:px-9 md:py-7", "shadow-soft", className]}>
  <p class="mb-3 text-xs font-medium uppercase tracking-[0.22em] text-brand-green">{label}</p>
  <div class="body-copy text-ink text-base md:text-lg" set:html={html} />
</aside>
