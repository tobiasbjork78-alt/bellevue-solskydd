---
import Icon from "./Icon.astro";
---
<div class="fixed bottom-0 inset-x-0 z-30 lg:hidden">
  <div class="grid grid-cols-2 gap-px bg-ink/10 border-t border-ink/10 backdrop-blur">
    <a href="tel:+46401811100" class="flex items-center justify-center gap-2 bg-canvas-soft py-4 text-sm font-medium text-ink">
      <Icon name="phone" size={16} />
      Ring 040-18 11 00
    </a>
    <a href="/kontakt/" class="flex items-center justify-center gap-2 bg-brand-green py-4 text-sm font-medium text-ink-inverse">
      <Icon name="calendar" size={16} />
      Boka rådgivning
    </a>
  </div>
</div>
