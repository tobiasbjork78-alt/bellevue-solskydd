---
import Icon from "./Icon.astro";
interface Props { icon: "house" | "shield-check" | "wrench" | "message-circle"; title: string; description?: string; class?: string; tone?: "light" | "dark" }
const { icon, title, description, class: className, tone = "light" } = Astro.props;
const light = tone === "light";
---
<div class:list={["flex items-start gap-4 rounded-soft px-5 py-4", light ? "bg-canvas-soft border border-ink/8" : "bg-ink-inverse/5 border border-ink-inverse/10", className]}>
  <span class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-full", light ? "bg-brand-green/10 text-brand-green" : "bg-brand-brass/15 text-brand-brass"]}>
    <Icon name={icon} size={18} />
  </span>
  <div>
    <p class:list={["font-medium leading-tight", light ? "text-ink" : "text-ink-inverse"]}>{title}</p>
    {description && <p class:list={["mt-1 text-sm", light ? "text-ink-soft" : "text-ink-inverse/70"]}>{description}</p>}
  </div>
</div>
