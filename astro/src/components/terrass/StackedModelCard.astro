---
// Port of StackedModelCard from nextjs-v3/app/terrassmarkiser-malmo/page.tsx
interface Model {
  maker: string;
  name: string;
  type: string;
  body: string;
  specs: string[];
  passarDigOm: string;
  extraNote?: { kind: "kundord" | "begransning"; text: string; source?: string };
  alt: string;
  image: string | null;
}
interface Props {
  model: Model;
  index: number;
  isLast: boolean;
  placeholder: string;
  variant?: "default" | "warm";
}
const { model, index, isLast, placeholder, variant = "default" } = Astro.props;
const warm = variant === "warm";
const eager = index === 0;
---
<article class:list={["grid gap-8 md:gap-12 md:grid-cols-2 md:items-center", warm ? "py-10 md:py-12" : "py-12 md:py-16", !isLast && "border-b border-brand-brass/30"]}>
  <div class="relative aspect-[16/9] bg-canvas overflow-hidden">
    {model.image ? (
      <img src={model.image} alt={model.alt} loading={eager ? "eager" : "lazy"} decoding="async" sizes="(max-width: 768px) 100vw, 50vw" class="absolute inset-0 h-full w-full object-cover" />
    ) : (
      <>
        <img src={placeholder} alt={model.alt} loading={eager ? "eager" : "lazy"} decoding="async" sizes="(max-width: 768px) 100vw, 50vw" class="absolute inset-0 h-full w-full object-cover opacity-0" />
        <div class:list={["absolute inset-0 flex items-center justify-center", warm ? "bg-canvas-soft/40" : ""]}>
          <span class="text-ink/25 font-display text-3xl md:text-4xl tracking-wide select-none">{model.name}</span>
        </div>
      </>
    )}
  </div>

  <div class="md:py-2">
    <p class="text-xs font-medium uppercase tracking-[0.22em] text-brand-green mb-3">{model.maker}</p>
    <h3 class:list={["font-display text-ink tracking-tight leading-[1.05] mb-2", warm ? "text-2xl md:text-3xl lg:text-4xl" : "text-3xl md:text-4xl lg:text-5xl"]}>{model.name}</h3>
    <p class="text-sm font-medium text-ink-soft mb-6">{model.type}</p>
    <p class:list={["body-copy text-ink mb-6 max-w-prose", warm ? "text-base md:text-lg" : ""]}>{model.body}</p>
    {model.specs.length > 0 && (
      <ul class="space-y-2 text-sm body-copy text-ink-soft list-none mb-6">
        {model.specs.map((spec) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="text-brand-brass select-none leading-snug">—</span>
            <span>{spec}</span>
          </li>
        ))}
      </ul>
    )}
    <p class="text-sm body-copy text-ink-soft border-l-2 border-brand-brass/40 pl-4 italic">{model.passarDigOm}</p>
    {model.extraNote && (
      <div class="mt-6 pt-5 border-t border-ink/8">
        <p class="text-sm body-copy text-ink-soft">
          {model.extraNote.kind === "kundord" ? (
            <>
              <span class="text-ink">&ldquo;{model.extraNote.text}&rdquo;</span>
              {model.extraNote.source && <> <span class="text-ink-soft/70 text-xs">— {model.extraNote.source}</span></>}
            </>
          ) : (
            <>
              {model.extraNote.text}
              {model.extraNote.source && <> <span class="text-ink-soft/70 text-xs">({model.extraNote.source})</span></>}
            </>
          )}
        </p>
      </div>
    )}
  </div>
</article>
