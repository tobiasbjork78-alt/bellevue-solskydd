        }
      }
    ],
    "vanliga_problem": [
      {
        "text": "Folding arm awning cassettes can develop cracks in facade mounting points or come loose due to leverage forces, especially if facade is not resistant enough. May require chemical anchors or extended roof supports.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Almost all sunshade fabrics expand over time, causing: cassette not closing completely (leaving part of fabric visible and sometimes discoloured), and fabric no longer being neatly taut. Usually remedied by reprogramming motor settings.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Front panel hanging higher on one side than the other — usually adjustable with adjusting screws but requires holding up the affected arm during adjustment.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Wireless remote control stops working — usually a battery replacement issue, reprogramming may be necessary.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Fabric tears from wind-blown debris, tree branches, or UV degradation over time — common to all retractable awnings, particularly in high-UV environments.",
        "kalla": {
          "domän": "cflawnings.com",
          "url": "https://cflawnings.com/awning-repair-5-common-problems-you-can-fix-yourself/"
        }
      },
      {
        "text": "Retractable awning sagging or loose areas over time due to stretched fabric or improper tension adjustments.",
        "kalla": {
          "domän": "aladdininc.net",
          "url": "https://aladdininc.net/retractable-awning-troubleshooting-common-issues-and-solutions/"
        }
      }
    ],
    "olampliga_lagen": [
      {
        "text": "Never leave folding arm awning extended when you are not around — sensitive to wind gusts which can result in considerable damage.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "If facade material is not resistant to the leverage caused by the folding arm awning, alternative mounting or alternative products (e.g., freestanding pergola awning) may be needed.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      }
    ],
