  },
  "aterforsaljarkunskap": {
    "praktiska_tipps": [
      {
        "text": "Use your folding arm awning regularly and watch for abnormalities, acting on them immediately. After a period of non-use, always pay extra attention.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
