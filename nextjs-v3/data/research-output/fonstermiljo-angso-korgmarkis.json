  "sardrag": [
    {
      "text": "Korgmarkisen är en tidlös produkt som stänger ute solen åt alla håll. Mjuka, runda, omslutande former bryter av mot de raka fönstren och skapar harmoni.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    },
    {
      "text": "Korgmarkisen förses med antingen klassisk tät markisväv, eller screenväv. Screenväven behåller utsikten och solen silas då istället genom den glesare vävda väven.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    },
    {
      "text": "Korgmarkisen finns i en rad olika utföranden från klassisk, trappad, till böjd eller cylindrisk.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    },
    {
      "text": "Maxbredd: 6.0 m, Utfall: 50 cm – 2.0 m, Profiler: Naturanodiserad, Manövrering: Linuppdrag eller motoriserad, Vindklass: 3 enligt EN13561, Kappa: Rak eller vågig.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    },
    {
      "text": "Går att få som uppdragbar eller fast markis. Väljer du den som uppdragbar ingår manövrering med utvändig- eller invändig lina. Som tillval finns även motor.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    },
    {
      "text": "Välj markisduk från Dickson, Sandatex och Soltis.",
      "kalla": {
        "domän": "arcocrown.se",
        "url": "https://arcocrown.se/produkter/fonstermarkiser/hestra-ingvar-korgmarkis/"
      }
    }
