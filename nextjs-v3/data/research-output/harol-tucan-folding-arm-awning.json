  "begransningar_och_negativ_info": {
    "begransningar": [
      {
        "text": "Maximum width limited to 6 m and maximum drop to 3,5 m.",
        "kalla": {
          "domän": "harol.com",
          "url": "https://www.harol.com/en/products/solar-shading/folding-arm-awnings/tucan/"
        }
      },
      {
        "text": "Folding arm awnings are sensitive to wind (gusts) — never leave in off/on position when not around, as this can result in considerable damage.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Mounting requires pressure-resistant substrate (drukvaste ondergrond). Minimum anchor diameter 12 mm, with chemical anchoring required.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      }
    ],
    "vanliga_problem": [
      {
        "text": "Cracks appearing in the facade to which the folding arm awning cassette is mounted and/or cassette coming loose — usually indicates facade is not resistant to the leverage caused by the awning. May need chemical anchors, extended roof supports or alternative sun protection product.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Cassette no longer closing completely, leaving a small part of the sunshade visible (and sometimes discoloured) — usually because almost all sunshades expand over time. Usually easily remedied by reprogramming the motor setting.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Front panel hangs higher on one side than the other — can usually be adjusted using adjusting screws; the affected arm must be held up during adjustment to avoid damage.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Sun sail no longer neatly tight — usually because fabric expands over time. Fix by reprogramming motor adjustment.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "No response from remote control — usually means battery needs replacement; reprogramming may be necessary.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Sagging fabric from strong winds whipping the awning back and forth, possibly overextending the canopy.",
        "kalla": {
          "domän": "rollac.com",
          "url": "https://rollac.com/r/retractable-awning-problems/"
        }
      },
      {
        "text": "Motor issues: awning jams or jerks when retracting — most complex mechanical issue, best handled by a professional.",
        "kalla": {
          "domän": "rollac.com",
          "url": "https://rollac.com/r/retractable-awning-problems/"
        }
      },
      {
        "text": "Fabric damage from tears, UV fading, mold and mildew — repair with special patches/tape; waterproof adhesive for waterproof fabric. Mold prevention: spray with hose, apply mildew remover, let dry completely before retracting.",
        "kalla": {
          "domän": "rollac.com",
          "url": "https://rollac.com/r/retractable-awning-problems/"
        }
      },
      {
        "text": "Fabric tears near seams or areas of tension require professional intervention. Fabric must be dismantled for sewing repairs, remembering to immobilise the arms to avoid the spring effect.",
        "kalla": {
          "domän": "dickson-constant.com",
          "url": "https://www.dickson-constant.com/en/how-to-repare-folding-arm-awning/"
        }
      }
    ],
    "olampliga_lagen": [
      {
        "text": "If facade is not resistant to the leverage caused by the folding arm awning, alternative sun protection such as a facade-mounted or freestanding pergola awning may be needed instead.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Not suitable for leaving extended unattended — sensitive to wind gusts which can cause considerable damage.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      }
    ],
    "tomhetsanteckning": null
  },
  "aterforsaljarkunskap": {
    "praktiska_tipps": [
      {
        "text": "Use folding arm awning regularly and watch for abnormalities, acting immediately. After a period of non-use, always pay extra attention.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Annual servicing recommended: inspect moving parts for breakage, rust, or corrosion; inspect fabric for fading or rips; lubricate tracks with silicone lubricant spray.",
        "kalla": {
          "domän": "rollac.com",
          "url": "https://rollac.com/r/retractable-awning-problems/"
        }
      },
      {
        "text": "When adjusting the front panel levelling, the affected jib arm must be held up during adjustment; otherwise nothing will happen and/or you risk damage.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Fabric can be replaced without changing hinged arms, motor, box, and fixed parts — a durable, aesthetic and relatively economical solution for replacing a damaged awning fabric.",
        "kalla": {
          "domän": "dickson-constant.com",
          "url": "https://www.dickson-constant.com/en/how-to-repare-folding-arm-awning/"
        }
      },
      {
        "text": "Thorough cleaning once a year recommended. Choose a wind-free, warm and sunny spring day. Allow to dry completely after washing and restoring water repellency.",
        "kalla": {
          "domän": "dickson-constant.com",
          "url": "https://www.dickson-constant.com/en/how-to-repare-folding-arm-awning/"
        }
      },
      {
        "text": "Always contact the original installer first before attempting DIY repairs, as you may still have warranty — or invalidate existing warranty by doing it yourself.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      }
    ],
    "vanliga_felval": [
      {
        "text": "Mounting on a facade that cannot withstand the leverage of the folding arm awning — leads to cracks and loosening. May need chemical anchors or extended roof supports.",
        "kalla": {
          "domän": "luvifem.nl",
          "url": "https://www.luvifem.nl/en/knikarmscherm-repareren/"
        }
      },
      {
        "text": "Choosing DIY installation without experience — improperly installed awnings are more susceptible to wind damage since some parts will not be secured correctly.",
        "kalla": {
          "domän": "rollac.com",
          "url": "https://rollac.com/r/retractable-awning-problems/"
        }
      }
    ],
    "monteringskunskap": [
      {
        "text": "36-page mounting instruction manual available in Dutch, French, English, and German. Includes technical drawings, mounting steps with video reference, and electrical schemes.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      },
      {
        "text": "Four mounting types: Type 1 wall mount (5°–38°), Type 2 wall mount (38°–90°), Type 3 ceiling mount (14°–52°), Type 4 ceiling mount (52°–90°).",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      },
      {
        "text": "Requires minimum Ø 12 mm anchors with chemical anchoring (chemisch verankeren). Fixation on pressure-resistant substrate required.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      },
      {
        "text": "Electric operation uses Somfy OREA 50 WT 25/17 or OREA 50 WT 40/17 motors; see Somfy instruction manual included. Also compatible with Orea 25/17 LT50 RTS.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      },
      {
        "text": "For ceiling mounting (Type 3–4): minimum 20 mm and 55 mm clearances specified.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3314125/Harol-Tucan-065842.html"
        }
      },
      {
        "text": "Before sewing repairs on fabric, fabric must be dismantled and arms immobilised to avoid the spring effect. This operation can be tricky — professional recommended.",
        "kalla": {
          "domän": "dickson-constant.com",
          "url": "https://www.dickson-constant.com/en/how-to-repare-folding-arm-awning/"
        }
      }
    ],
