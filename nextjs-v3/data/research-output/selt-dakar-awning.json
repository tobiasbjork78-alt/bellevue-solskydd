  "aterforsaljarkunskap": {
    "praktiska_tipps": [
      {
        "text": "The awning is delivered fully assembled and adjusted. Installation is limited to attaching the brackets to the wall (or ceiling/rafters). The tilt angle can be freely set after mounting if needed.",
        "kalla": {
          "domän": "shopsun.eu",
          "url": "https://shopsun.eu/terrace-awning-dakar/"
        }
      },
      {
        "text": "Wall brackets should be mounted in the place marked by the manufacturer at the back of the cassette, so that they are in the symmetry axis of the arm brackets.",
        "kalla": {
          "domän": "shopsun.eu",
          "url": "https://shopsun.eu/terrace-awning-dakar/"
        }
      },
      {
        "text": "Number of brackets depends on width: S ≤ 4.1 m requires 2 handles; S > 4.1 m requires 3 handles. This quantity is obligatory and the awning is standardly equipped by the manufacturer with this number.",
        "kalla": {
          "domän": "shopsun.eu",
          "url": "https://shopsun.eu/terrace-awning-dakar/"
        }
      },
      {
        "text": "Console brackets have 4 mounting points each. The number of brackets ranges from 2 to 4 depending on the width of the awning. Available in wall, ceiling, or rafter versions.",
        "kalla": {
          "domän": "e-markizy.pl",
          "url": "https://e-markizy.pl/blog/produkty-guthenberg/markiza-tarasowa-dakar-selt-guthenberg/?srsltid=AfmBOopRDLpL4Nenc_k6rrElgKu0cQ8lBqiY0zVYal_edubZ8wIGWGnE"
        }
      },
      {
        "text": "Telescopic supports work well especially with manual drive as additional support for the front bar.",
        "kalla": {
          "domän": "e-markizy.pl",
          "url": "https://e-markizy.pl/blog/produkty-guthenberg/markiza-tarasowa-dakar-selt-guthenberg/?srsltid=AfmBOopRDLpL4Nenc_k6rrElgKu0cQ8lBqiY0zVYal_edubZ8wIGWGnE"
        }
      },
      {
        "text": "When ordering, always provide the total external width of the awning including the handles. Projection refers to the degree of extension.",
        "kalla": {
          "domän": "e-markizy.pl",
          "url": "https://e-markizy.pl/blog/produkty-guthenberg/markiza-tarasowa-dakar-selt-guthenberg/?srsltid=AfmBOopRDLpL4Nenc_k6rrElgKu0cQ8lBqiY0zVYal_edubZ8wIGWGnE"
        }
      },
      {
        "text": "Prior to first start of the electrically driven product, electrical measurements should be performed by a person holding adequate permissions. Do not start the motor without checking correctness of system installation.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3151035/Selt-Dakar.html?page=16"
        }
      },
      {
        "text": "Using an impregnating agent at the beginning of the season is a good practice to extend fabric lifespan and utility.",
        "kalla": {
          "domän": "e-markizy.pl",
          "url": "https://e-markizy.pl/blog/produkty-guthenberg/markiza-tarasowa-dakar-selt-guthenberg/?srsltid=AfmBOopRDLpL4Nenc_k6rrElgKu0cQ8lBqiY0zVYal_edubZ8wIGWGnE"
        }
      }
    ],
    "vanliga_felval": [
      {
        "text": "Manual crank operation without overturn protection means applying too much force when closing can damage the fabric. Users should turn the crank only until gentle resistance is felt.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3151035/Selt-Dakar.html?page=16"
        }
      }
    ],
    "monteringskunskap": [
      {
        "text": "Awning opening with manual drive is performed by making enough turns with the crank until the arms are opened, keeping the fabric tension. Closure by turning the crank until gentle resistance is felt.",
        "kalla": {
          "domän": "manualslib.com",
          "url": "https://www.manualslib.com/manual/3151035/Selt-Dakar.html?page=16"
        }
      },
      {
        "text": "The awning can be installed on insulated walls (e.g. polystyrene up to 20 cm) without cutting out the insulation, using a special chemical anchoring kit.",
        "kalla": {
          "domän": "shopsun.eu",
          "url": "https://shopsun.eu/terrace-awning-dakar/"
        }
      },
      {
        "text": "Three mounting methods: wall brackets (standard, most common), ceiling brackets (extra fee), roof rafter brackets (extra fee).",
        "kalla": {
          "domän": "e-markizy.pl",
          "url": "https://e-markizy.pl/blog/produkty-guthenberg/markiza-tarasowa-dakar-selt-guthenberg/?srsltid=AfmBOopRDLpL4Nenc_k6rrElgKu0cQ8lBqiY0zVYal_edubZ8wIGWGnE"
        }
      }
