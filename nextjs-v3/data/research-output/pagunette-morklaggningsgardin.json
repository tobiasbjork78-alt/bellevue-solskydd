  "sardrag": [
    {
      "text": "Pagunette erbjuder textilier med ljusäkthetsinformation enligt ISO 105-B02 (skala 1–8, där 8 är högst motstånd mot blekning). Information om ljusäkthet finns på hemsidan för de flesta textilier.",
      "kalla": {
        "domän": "pagunette.se",
        "url": "https://www.pagunette.se/inspiration/guider/ljusakthet"
      }
    },
    {
      "text": "Gardiner kan fodras för att skydda textilier från att blekna — de fodrade lagren fungerar som en barriär som absorberar eller reflekterar en stor del av solljusets energi, vilket hjälper till att bibehålla färgernas intensitet.",
      "kalla": {
        "domän": "pagunette.se",
        "url": "https://www.pagunette.se/inspiration/guider/ljusakthet"
      }
    },
    {
      "text": "Pagunette tillverkar liftgardiner som kan monteras i vägg eller tak, med antingen ändlös kedja eller snördrag som manövreringsmekanism.",
      "kalla": {
        "domän": "pagunette.no",
        "url": "https://www.pagunette.no/inspirasjon/guider/liftgardin-montering"
      }
    },
    {
      "text": "Pagunettes produktkategorier inkluderar bl.a. lysdämpande metervarer, gardintillbehör, mönstrade och enfärgade textilier, extra breda textilier och slitstarka tyger med Martindale-klassning.",
      "kalla": {
        "domän": "pagunette.dk",
        "url": "https://www.pagunette.dk/produkter"
      }
    },
    {
      "text": "Plain Wool-textilen (exempel på Pagunette-metervara) har komposition 70% WOOL / 30% PES (100% RECYCLED WOOL), egenskaper Akustik, Flammehæmmende (FR), Recycled, Martindale 60.000, ljusäkthet ISO 105 B02 SCALE 5 (1-8), och certifiering enligt Global Recycled Standard (GRS).",
      "kalla": {
        "domän": "b2b.pagunette.dk",
        "url": "https://b2b.pagunette.dk/gardiner/gardiner/metervarer-alle/plain-wool-18"
      }
    }
  ],
