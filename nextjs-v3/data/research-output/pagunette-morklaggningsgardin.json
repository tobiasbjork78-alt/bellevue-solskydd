  "begransningar_och_negativ_info": {
    "begransningar": [
      {
        "text": "Alla gardiner som utsätts för solljus kommer att blekna med tiden — även med hög ljusäkthet. Naturfibrer som bomull, linne och siden är särskilt känsliga för blekning.",
        "kalla": {
          "domän": "pagunette.se",
          "url": "https://www.pagunette.se/inspiration/guider/ljusakthet"
        }
      },
      {
        "text": "Vissa färger är mer mottagliga för nyansförändringar — t.ex. om det gula färgämnet bleknar snabbare än det blå skiftar nyansen mot blått. Röd färg kan utveckla en mer orange eller rosa nyans med tiden.",
        "kalla": {
          "domän": "pagunette.se",
          "url": "https://www.pagunette.se/inspiration/guider/ljusakthet"
        }
      },
      {
        "text": "Övergång till mer hållbara och miljövänliga färgningsmetoder kan innebära att moderna textilier bleknar lättare jämfört med äldre textilier som använde mer kemikalier.",
        "kalla": {
          "domän": "pagunette.se",
          "url": "https://www.pagunette.se/inspiration/guider/ljusakthet"
        }
      }
    ],
    "vanliga_problem": [
      {
        "text": "Liftgardiner: snören kan ibland 'hoppa' ut ur det lilla hålet i spolarna, vilket ger problem med gardinens funktion. Kontrollera att snören sitter korrekt i spolarna.",
        "kalla": {
          "domän": "pagunette.no",
          "url": "https://www.pagunette.no/inspirasjon/guider/liftgardin-montering"
        }
      }
    ],
    "olampliga_lagen": [
      {
        "text": "Tjocka gardiner framför akustisk dämpning kan påverka dämpningens effekt negativt — tunna, genomsläppliga tyger rekommenderas istället.",
        "kalla": {
          "domän": "faktiskt.io",
