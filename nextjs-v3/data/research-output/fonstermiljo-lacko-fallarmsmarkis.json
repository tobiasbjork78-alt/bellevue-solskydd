  "sardrag": [
    {
      "text": "Läckö är en kraftigare fönstermarkis i samma design som Solliden. Till skillnad från Solliden går den dock att seriekoppla.",
      "kalla": {
        "domän": "amagruppen.se",
        "url": "https://amagruppen.se/produkter/utvandiga-solskydd/lacko-fonstermarkis/"
      }
    },
    {
      "text": "Max storlek — Bredd: 600 cm, Utfall: 160 cm / 160 cm motoriserat, Täckhöjd: 320 cm",
      "kalla": {
        "domän": "amagruppen.se",
        "url": "https://amagruppen.se/produkter/utvandiga-solskydd/lacko-fonstermarkis/"
      }
    },
    {
      "text": "Reglagealternativ: Motorstyrning, Snäckväxel med vev, invändigt/utvändigt dragband",
      "kalla": {
        "domän": "amagruppen.se",
        "url": "https://amagruppen.se/produkter/utvandiga-solskydd/lacko-fonstermarkis/"
      }
    },
    {
      "text": "Stativfärg: Aluminium",
      "kalla": {
        "domän": "amagruppen.se",
        "url": "https://amagruppen.se/produkter/utvandiga-solskydd/lacko-fonstermarkis/"
      }
    },
    {
      "text": "Förstärkt markis som tål stora vindpåfrestningar. Fälls in i en diskret kassett som skyddar väven extra mot regn, sol och smuts.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Markisens styrs med en motor som kan seriekopplas. Genom att lägga till sensorer för sol och vind kan markiserna styras automatiskt.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Stort utbud av färger, antingen i tät markisväv eller screenväv som man kan se igenom. Alla vävar är vattenavvisande.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Kassett kan fås lackerad i valfri färg.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Det går att få markisen med eller utan kappa som hänger ner längst fram.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    }
  ],
  "anvandningsfall": [
    {
      "text": "Klassisk solavskärmning som passar på äldre fasader. Fönstermarkis kan bidra med karaktär till en fasad och fungerar väldigt fint på äldre byggnader.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Markiser som solavskärmning ger bra utsikt under markisväven samtidigt som de ger bra solavskärmning och klimatkontroll eftersom den stoppar värmen innan den når fönsterrutan.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Markiser fungerar även på bredare fönsterpartier men för extra höga fönster rekommenderas andra solavskärmningar såsom zipscreen eller fasadpersienn.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    },
    {
      "text": "Erbjuds till arkitekter, fastighetsägare och byggare.",
      "kalla": {
        "domän": "skanskfonstermiljo.se",
        "url": "https://skanskfonstermiljo.se/produkt/fonstermarkis-2/"
      }
    }
  ],
